# Все переменные опциональны; agent.py читает их из окружения процесса.
# Без непустого OPENAI_API_KEY LLM-советник выключен,
# agent.py работает полностью детерминированно и не требует .env.
OPENAI_API_KEY=

# Опционально: модель советника; пустое значение использует gpt-5.6-luna.
OPENAI_MODEL=

# Опционально: базовый URL API; пустое значение использует https://api.openai.com/v1.
OPENAI_BASE_URL=
